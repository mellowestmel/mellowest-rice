# General
font=Lato 11

background-color=#181818
text-color=#e8e8e8

width=500
height=150

anchor=top-right

outer-margin=10
margin=5,0
padding=16,20

border-size=0
border-color=#181818
border-radius=0

max-visible=5
max-history=20

default-timeout=5000

icons=1
max-icon-size=48
icon-location=left
icon-border-radius=0

text-alignment=left

# Notification format
format=<b>%s</b>\n%b

# Click to dismiss
on-button-left=dismiss
on-button-middle=dismiss
on-button-right=dismiss

# Critical notifications
[urgency=critical]
background-color=#181818
text-color=#e4e78c
border-size=0
default-timeout=0

# Low-priority notifications
[urgency=low]
background-color=#111111
text-color=#aaaaaa